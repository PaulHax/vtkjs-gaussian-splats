{
  "name": "vtkjs-gaussian-splats",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive Gaussian splat scenes rendered with VTK.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prepare:vtk": "node scripts/prepareVtk.mjs",
    "prepare:models": "node scripts/prepareGaussianAerial.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "3.10.3",
    "@types/node": "26.1.1",
    "playwright": "1.62.0",
    "sharp": "0.34.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
