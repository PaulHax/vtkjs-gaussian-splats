+    return true;
+  }
+
+  publicAPI.getNeedToRebuildBufferObjects = () => {
+    const poly = model.currentInput;
+    if (
+      model.bufferKeys?.context === model.context &&
+      model.bufferKeysTime.getMTime() >
+        Math.max(poly.getMTime(), model.renderable.getMTime())
