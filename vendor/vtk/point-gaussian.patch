+    if (!colorSelection) {
+      cabo.getColorBO()?.releaseGraphicsResources();
+      cabo.setColorBO(null);
+      cabo.setColorComponents(0);
+      return;
+    }
+    // Mapped colours are RGBA bytes.
+    cabo.setColorBO(
