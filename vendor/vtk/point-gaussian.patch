+      bind(model.rotationBO, 'rotationMC', 4);
+    }
+    if (opacity) {
+      bind(model.opacityBO, 'scalarOpacity', 1);
+    }
+  }
+
+  publicAPI.setMapperShaderParameters = (cellBO, ren, actor) => {
+    // The superclass binds its attributes again when the buffers or the
+    // program change.
